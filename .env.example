# Copy this file to .env and fill in the keys. The app starts without them.

# Turns on judging. A new OpenRouter key made only for this project.
OPENROUTER_API_KEY=
# Optional. Blank uses the built-in choices: anthropic/claude-sonnet-5.5 at
# https://openrouter.ai/api/v1, with the model's thinking step on.
LLM_MODEL=
LLM_BASE_URL=
# on or off
LLM_THINKING=

# Turns on speech in and out.
SARVAM_API_KEY=
# Optional. Blank uses the built-in choices: saaras:v4 in codemix mode for
# listening, and bulbul:v3 with the voices shubh (male) and ritu (female).
SARVAM_STT_MODEL=
SARVAM_STT_MODE=
SARVAM_TTS_MODEL=
SARVAM_TTS_VOICE_MALE=
SARVAM_TTS_VOICE_FEMALE=

# Shown on the no-keys screen. Leave blank to use the links built into the code.
LIVE_DEMO_URL=
VIDEO_URL=

# How long a session lives, and the limits that protect the public link.
SESSION_TTL_MINUTES=30
RATE_LIMIT_PER_MINUTE=30
DAILY_REQUEST_CAP=2000
# Paid model calls allowed per day (about one per learner turn).
DAILY_MODEL_CALL_CAP=400

# For the developer only: "on" adds a page at /dev/sessions that shows the
# conversations currently in memory. Leave blank on any public link.
DEV_VIEWER=
