# Copy this file to .env and fill in the keys. The app starts without them.

# Turns on judging. A new OpenRouter key made only for this project.
OPENROUTER_API_KEY=
# Model name and chat endpoint, from OpenRouter's current list and docs.
LLM_MODEL=
LLM_BASE_URL=

# Turns on speech in and out.
SARVAM_API_KEY=
SARVAM_STT_MODEL=
# codemix or verbatim
SARVAM_STT_MODE=
SARVAM_TTS_VOICE=

# Shown on the no-keys screen. Leave blank to use the links built into the code.
LIVE_DEMO_URL=
VIDEO_URL=

# How long a session lives, and the limits that protect the public link.
SESSION_TTL_MINUTES=30
RATE_LIMIT_PER_MINUTE=30
DAILY_REQUEST_CAP=2000
